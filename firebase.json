{
  "hosting": {
    "target": "site",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "*.mjs",
      "package.json"
    ],
    "cleanUrls": false,
    "redirects": [
      { "source": "/", "destination": "https://kinetixfsl.app/", "type": 301 },
      { "source": "/:path*", "destination": "https://kinetixfsl.app/:path*", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
